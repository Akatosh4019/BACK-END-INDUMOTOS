{
  "info": {
    "name": "Indumotos | HU-15-T06 | Accesos y excepciones",
    "description": "Ejecución secuencial con cuentas ficticias. Configure adminPassword y testPassword antes de ejecutar. No incluya tokens ni contraseñas en capturas. Elimine las cuentas y registros de prueba después.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('runId')) {",
          "  const runId = String(Date.now());",
          "  pm.collectionVariables.set('runId', runId);",
          "  pm.collectionVariables.set('almacenUsername', 't06_almacen_' + runId);",
          "  pm.collectionVariables.set('inventoryUsername', 't06_inventarios_' + runId);",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 Salud API",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/health",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('01 Salud API: HTTP 200', () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) {",
              "const data = pm.response.json();",
              "pm.test('API activa', () => pm.expect(data.status).to.eql('ok'));",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Login ADMIN",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/auth/login",
        "auth": {
          "type": "noauth"
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"nombreUsuario\":\"{{adminUsername}}\",\"clave\":\"{{adminPassword}}\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('02 Login ADMIN: HTTP 200', () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) {",
              "const data = pm.response.json();",
              "pm.collectionVariables.set('adminToken', data.accessToken);",
              "pm.test('Bearer y caducidad', () => { pm.expect(data.tokenType).to.eql('Bearer'); pm.expect(data.expiresIn).to.eql(3600); });",
              "}"
            ]
          }
        }
      ]
    },
