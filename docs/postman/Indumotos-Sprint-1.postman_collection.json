{
  "info": {
    "name": "Indumotos | Sprint 1 | Acceso, llegadas y fichas",
    "description": "HU-14, HU-26, HU-04, HU-02 y HU-15. Ejecutar en orden. La colección crea cuentas ficticias y verifica permisos por rol y excepciones; usar solo en entorno local. Tokens y contraseñas quedan en variables locales de Postman.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "00 - Verificar API",
      "request": {
        "method": "GET",
        "auth": {
          "type": "noauth"
        },
        "url": "{{baseUrl}}/api/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('API activa: 200', () => pm.response.to.have.status(200));",
              "pm.test('Estado ok', () => pm.expect(pm.response.json().status).to.eql('ok'));"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Login administrador - Obtener token (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Login correcto: 200', () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) {",
              "  const data = pm.response.json();",
              "  pm.collectionVariables.set('adminToken', data.accessToken);",
              "  pm.test('Token Bearer de 15 minutos', () => { pm.expect(data.tokenType).to.eql('Bearer'); pm.expect(data.expiresIn).to.eql(900); });",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "auth": {
          "type": "noauth"
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombreUsuario\": \"{{adminUsername}}\",\n  \"clave\": \"{{adminPassword}}\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/auth/login"
      }
    },
    {
      "name": "01 - Crear cuenta ALMACEN (201)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "pm.collectionVariables.set('testUsername', 'prueba_postman_' + Date.now());"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Cuenta creada: 201', () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) {",
              "  const data = pm.response.json();",
              "  pm.test('Respuesta sin clave ni hash', () => {",
              "    pm.expect(data.nombreUsuario).to.eql(pm.collectionVariables.get('testUsername'));",
              "    pm.expect(data).not.to.have.property('clave');",
              "    pm.expect(data).not.to.have.property('claveHash');",
              "  });",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombreCompleto\": \"Prueba Postman\",\n  \"nombreUsuario\": \"{{testUsername}}\",\n  \"clave\": \"{{testUserPassword}}\",\n  \"rolCodigo\": \"ALMACEN\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/usuarios"
